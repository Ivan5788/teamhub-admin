{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "oxc"],
  "categories": { "correctness": "error" },
  "ignorePatterns": ["dist"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/features/*/**"],
            "message": "模組之間只能透過 index.ts 引用，例如 '@/features/employees'"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/**", "src/hooks/**", "src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features", "@/features/**", "**/features/**"],
                "message": "共用層不能依賴業務模組，相依方向必須是 features → 共用層"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "fetch", "message": "請透過 ResourceApi 與 hooks 取資料，不要直接呼叫 fetch" }
        ]
      }
    },
    {
      "files": ["src/features/**/pages/**", "src/features/**/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/**"],
                "message": "模組之間只能透過 index.ts 引用，例如 '@/features/employees'"
              },
              {
                "group": ["../../*/**"],
                "message": "模組之間只能透過 index.ts 引用，例如 '@/features/employees'"
              },
              {
                "group": ["../api", "@/features/*"],
                "importNamePattern": "Api$",
                "message": "頁面與元件一律使用 hooks，不要直接呼叫 API 物件"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "no-restricted-imports": "off" }
    }
  ]
}
